# Salin jadi .env (JANGAN commit .env asli)
VS_MODEL_PATH=../ml-visual-search/export/v4_11class/model.onnx
VS_CATALOG_PATH=../ml-visual-search/data/cache/catalog_embeddings.npz
VS_LABEL_MAP_PATH=../ml-visual-search/export/v4_11class/label_to_idx__style_name.json
API_HOST=0.0.0.0
API_PORT=8000

# Verification engine -- Digital Art Identity (Art-to-Art + Art-to-AI).
# Hasil `python -m src.export` di ml-digital-art-identity/ (lihat README di sana).
DAI_ART_TO_ART_MODEL_PATH=../ml-digital-art-identity/export/art_to_art.onnx
DAI_ART_TO_AI_MODEL_PATH=../ml-digital-art-identity/export/art_to_ai.onnx
# Threshold, default = nilai yang sudah dikalibrasi di notebook (lihat
# ml-digital-art-identity/configs/config.yaml untuk sumber & alasan tiap angka).
# Ubah di sini kalau perlu re-kalibrasi TANPA redeploy kode.
DAI_DISTANCE_THRESHOLD=0.10
DAI_AI_PROBABILITY_THRESHOLD=0.5
DAI_PHASH_HAMMING_THRESHOLD=5

# Database (Neon Postgres). Copy connection string dari Neon dashboard
# (format "postgresql://user:pass@host/dbname?sslmode=require&channel_binding=require"), lalu:
#   1. ganti "postgresql://" -> "postgresql+asyncpg://" (driver async)
#   2. ganti "?sslmode=require" -> "?ssl=require" (asyncpg beda nama param)
#   3. HAPUS "&channel_binding=require" kalau ada -- param khusus psycopg/libpq,
#      asyncpg tidak kenal ini & akan error "unexpected keyword argument
#      'channel_binding'" kalau tidak dihapus.
# Contoh:
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?ssl=require
DATABASE_URL=

# Cloudflare R2 (penyimpanan gambar; S3-compatible). BELUM dibuat -- langkah di dashboard Cloudflare
# ada di CLAUDE.md root ("Checklist setup bucket sungguhan"). Isi di backend/.env, JANGAN di-commit.
#   R2_ENDPOINT         -> https://<account_id>.r2.cloudflarestorage.com   (utk upload/delete, butuh key)
#   R2_PUBLIC_URL_BASE  -> r2.dev subdomain / custom domain  (utk MENAMPILKAN gambar; beda dari endpoint!)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL_BASE=
# OPSIONAL -- isi bila r2.dev diblokir DNS provider HP (gambar kosong di app). Backend lalu menyajikan
# gambar sendiri lewat GET /api/gambar/<key>. Contoh utk HP via USB (adb reverse): http://127.0.0.1:8000/api/gambar
GAMBAR_PROXY_BASE=
# Di bawah ambang ini, gaya dianggap 'belum pasti' (v4: cakupan 75%, akurasi 0.85 pada uji 1.000 gambar)
VS_STYLE_ABSTAIN_T=0.70

# --- Dashboard admin (dashboard-admin/) ---
# Schema data contoh & waktu acuan (opsional; default dummy_admin & 2026-09-30T23:59:59Z)
ADMIN_SCHEMA=dummy_admin
ADMIN_WAKTU_ACUAN=2026-09-30T23:59:59Z
# OPSIONAL -- kunci lama utk skrip (header X-Admin-Key); login web memakai ADMIN_EMAIL di bawah.
ADMIN_API_KEY=
# Login dashboard admin (POST /api/admin/login). Buat nilainya dgn: python scripts/buat_hash_admin.py
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
