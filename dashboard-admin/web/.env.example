# Alamat backend FastAPI (default http://localhost:8000)
VITE_API_BASE=http://localhost:8000
# Opsional: harus sama dgn ADMIN_API_KEY di backend/.env bila diaktifkan.
# PERINGATAN: nilai VITE_* ikut ter-bundle ke JS browser -> ini BUKAN rahasia sungguhan,
# hanya pagar sementara sampai Auth admin selesai.
VITE_ADMIN_KEY=
